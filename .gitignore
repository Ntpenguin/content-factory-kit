# rendered pieces: rebuilt by the lanes (python -m factory.statics ...)
runs/*/*/pieces/
runs/*/*/*/pieces/
# Filmed clips are big; the stand-in test clip is the one exception
runs/*/*/media/raw/*
runs/*/*/media/clips/*-cut.mp4
!runs/builtwithbaron/footage-standin/media/raw/*
!runs/builtwithbaron/footage-standin/media/clips/*-cut.mp4

# The FASTEDITOR sound pack (676 MB, no licence file): kept local; picked sounds are copied into sounds/
sounds/fasteditor/
